# =============================================
# higress-ai-demo — environment variables template
# Copy to `infra/.env` and fill in real values
# =============================================

# --- LLM (豆包 Ark Coding Plan, OpenAI 兼容) ---
# ⚠️ 真实 key 写到 infra/.env(不进 git)
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
OPENAI_API_KEY=<your-ark-api-key>
# Ark 端点上的模型名(看你在 Ark 控制台里开通的模型)
OPENAI_MODEL=doubao-seed-1-6-250615

# --- Higress 网关(本机) ---
# 注:本机 8080 被另一个 docker 容器占,网关 HTTP 改用 8082
HIGRESS_GATEWAY_URL=http://localhost:8082
HIGRESS_CONSOLE_URL=http://localhost:8001
HIGRESS_ADMIN_USER=admin
HIGRESS_ADMIN_PASS=admin

# --- Nacos(本机) ---
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=public
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# --- Spring AI Demo ---
DEMO_SERVER_PORT=8088
DEMO_NACOS_DATA_ID=spring-ai-demo.yml
DEMO_NACOS_GROUP=DEFAULT_GROUP

# --- MCP echo server (Task 5) ---
ECHO_SERVER_URL=http://localhost:9999/echo
ECHO_SERVER_PORT=9999
