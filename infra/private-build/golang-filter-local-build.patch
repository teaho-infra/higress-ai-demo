diff --git a/plugins/golang-filter/Makefile b/plugins/golang-filter/Makefile
index 238d06b..34e34f4 100644
--- a/plugins/golang-filter/Makefile
+++ b/plugins/golang-filter/Makefile
@@ -9,4 +9,14 @@ build:
 									--build-arg GOARCH=${GOARCH} \
 									-t ${GO_FILTER_NAME} \
 									--output . \
-									.
\ No newline at end of file
+									.
+
+# 企业容器内直接编译，避免 make build 再启动 Docker。
+# 编译参数沿用本目录官方 Dockerfile 的 amd64 分支。
+GO ?= go
+OUTPUT ?= $(CURDIR)/golang-filter_$(GOARCH).so
+.PHONY: local-build
+local-build:
+	@test "$(GOARCH)" = amd64
+	mkdir -p $(dir $(OUTPUT))
+	CGO_ENABLED=1 GOOS=linux GOARCH=$(GOARCH) CC=x86_64-linux-gnu-gcc AS=x86_64-linux-gnu-as $(GO) build -o $(OUTPUT) -buildmode=c-shared .
